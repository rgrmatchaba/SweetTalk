{
  // Cloudflare Workers config for deploying the Sweet Talk frontend.
  // vite.config.ts enables Nitro (`nitro: { preset: "cloudflare-module" }`),
  // which emits the Worker entry + static assets under .output/ on `npm run build`.
  //
  // Deploy with: npx wrangler deploy
  // (runs `npm run build` via build.command below, then uploads .output/)
  //
  // After build, Nitro also writes `.output/server/wrangler.json` — if Wrangler
  // complains about paths, deploy with:
  //   npx wrangler deploy -c .output/server/wrangler.json
  "name": "sweet-talk-voice-health",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "MASTRA_API_URL": "https://sweet-talk-agents.onrender.com",
    "LLM_PROVIDER": "groq",
    "GROQ_MODEL": "llama-3.3-70b-versatile"
  }
}
