# LLM provider: ollama (local default) | anthropic (deploy)
LLM_PROVIDER=ollama

# Ollama — local testing (run: ollama pull llama3.2)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Anthropic — set LLM_PROVIDER=anthropic and your key when deploying
ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Mastra agents server (run separately: cd sweet-talk-agents/sweet-talk-agents && npm run dev)
MASTRA_API_URL=http://localhost:4111
