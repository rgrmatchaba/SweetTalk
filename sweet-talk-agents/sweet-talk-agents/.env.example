# LLM provider: ollama (local default) | anthropic (deploy)
LLM_PROVIDER=ollama

# Ollama — local testing (run: ollama pull llama3.2)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Anthropic — set LLM_PROVIDER=anthropic and your key when deploying
ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5

# Service role key — required by Mastra tools to read/write Supabase on behalf of users.
# Find it in: Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY="paste-your-service-role-key-here"

# Resend — used by the Caregiver Agent to email daily summaries.
# Find/create a key at: https://resend.com/api-keys
RESEND_API_KEY="paste-your-resend-api-key-here"
# RESEND_FROM_EMAIL="Sweet Talk <onboarding@resend.dev>"

